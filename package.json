{
  "name": "rollvia",
  "productName": "Rollvia",
  "private": true,
  "version": "1.0.1",
  "description": "Rollvia - Modern Windows Desktop Attendance Management Application",
  "author": "Rollvia",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"electron .\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:sheets": "node scripts/test-google-sheets.cjs",
    "electron:start": "cross-env SERVE_DIST=1 electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.rollvia.app",
    "productName": "Rollvia",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "Rollvia"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rollvia",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version}.${ext}"
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@oxlint/binding-win32-x64-msvc": "^1.85.0",
    "@rolldown/binding-win32-x64-msvc": "^1.2.11",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.1"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  }
}
